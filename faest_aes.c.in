static_assert(FAEST_SSS_LAMBDA == FAEST_EM_@SSS@S_LAMBDA, "Invalid parameters");
static_assert(FAEST_EM_@SSS@F_LAMBDA == FAEST_EM_@SSS@S_LAMBDA, "Invalid parameters");
static_assert(FAEST_EM_@SSS@F_Lenc == FAEST_EM_@SSS@S_Lenc, "Invalid parameters");
static_assert(FAEST_EM_@SSS@F_Nst == FAEST_EM_@SSS@S_Nst, "Invalid parameters");
static_assert(FAEST_SSS_R == FAEST_EM_@SSS@S_R, "Invalid parameters");
static_assert(FAEST_EM_@SSS@F_R == FAEST_EM_@SSS@S_R, "Invalid parameters");
static_assert(FAEST_EM_@SSS@F_Senc == FAEST_EM_@SSS@S_Senc, "Invalid parameters");
// for scan-build
static_assert(FAEST_EM_@SSS@F_LAMBDA * (FAEST_EM_@SSS@F_R + 1) / 8 ==
                  sizeof(aes_word_t) * FAEST_EM_@SSS@F_Nst * (FAEST_EM_@SSS@F_R + 1),
              "Invalid parameters");
// clang-format on

/* pad sizes to multiples of some value; assumes that a is a power of 2 */
#define PAD_TO(s, a) (((s) + (a) - 1) & ~((a) - 1))
#define BFSSS_ALLOC(s) faest_aligned_alloc(BFSSS_ALIGN, PAD_TO((s) * sizeof(bfSSS_t), BFSSS_ALIGN))

#define RCON_EVERY (4 * (FAEST_SSS_LAMBDA / 128))

static const bf8_t Rcon[30] = {
    0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36, 0x6c, 0xd8, 0xab, 0x4d, 0x9a,
    0x2f, 0x5e, 0xbc, 0x63, 0xc6, 0x97, 0x35, 0x6a, 0xd4, 0xb3, 0x7d, 0xfa, 0xef, 0xc5, 0x91,
};

static const uint8_t phi[9] = {0x05, 0x09, 0xf9, 0x25, 0xf4, 0x01, 0xb5, 0x8f, 0x63};

// ADD ROUND KEY
/*
Called in EncCstrnts, takes in owf_in (bits) and their tags (0 for prover, owf_in (bit) * delta for
verifier)
*/

static void aes_SSS_add_round_key_verifier(bfSSS_t* out_key, const bfSSS_t* in_key,
                                           const bfSSS_t* k_key, unsigned int Nst) {
  const unsigned int Nstbits = Nst * 32;

  for (unsigned int i = 0; i < Nstbits; i++) {
    bfSSS_add(&out_key[i], &in_key[i], &k_key[i]);
  }
}

static void aes_SSS_add_round_key_prover(uint8_t* out, bfSSS_t* out_tag, const uint8_t* in,
                                         const bfSSS_t* in_tag, const uint8_t* k,
                                         const bfSSS_t* k_tag, unsigned int Nst) {
  const unsigned int Nstbits = Nst * 32;

  xor_u8_array(in, k, out, Nstbits / 8);
  aes_SSS_add_round_key_verifier(out_tag, in_tag, k_tag, Nst);
}

// F256/F2.CONJUGATES
static void aes_SSS_f256_f2_conjugates_1(bfSSS_t* y, const uint8_t* state, unsigned int Nst) {
  const unsigned int Nst_bytes = Nst * 4;

  for (unsigned int i = 0; i != Nst_bytes; ++i) {
    uint8_t x0 = state[i];
    for (unsigned int j = 0; j != 7; ++j) {
      bfSSS_byte_combine_bits(&y[i * 8 + j], x0);
      x0 = bits_sq(x0);
    }
    bfSSS_byte_combine_bits(&y[i * 8 + 7], x0);
  }
}

static void aes_SSS_f256_f2_conjugates_SSS(bfSSS_t* y, const bfSSS_t* state, unsigned int Nst) {
  const unsigned int Nst_bytes = Nst * 4;

  for (unsigned int i = 0; i != Nst_bytes; ++i) {
    bfSSS_t x[8];
    bfSSS_byte_combine(&y[i * 8], state + i * 8);
    bfSSS_sq_bit(x, state + i * 8);
    for (unsigned int j = 1; j != 7; ++j) {
      bfSSS_byte_combine(&y[i * 8 + j], x);
      bfSSS_sq_bit_inplace(x);
    }
    bfSSS_byte_combine(&y[i * 8 + 7], x);
  }
}

// STATE TO BYTES
static void aes_SSS_state_to_bytes_verifier(bfSSS_t* out_key, const bfSSS_t* k_key,
                                            unsigned int Nst) {
  const unsigned int Nst_bytes = Nst * 4;
  for (unsigned int i = 0; i < Nst_bytes; i++) {
    bfSSS_byte_combine(&out_key[i], k_key + i * 8);
  }
}

static void aes_SSS_state_to_bytes_prover(bfSSS_t** out_deg, const uint8_t* k, const bfSSS_t* k_tag,
                                          unsigned int Nst) {
  const unsigned int Nst_bytes = Nst * 4;
  for (unsigned int i = 0; i < Nst_bytes; i++) {
    bfSSS_byte_combine_bits(&out_deg[1][i], k[i]);
  }

  aes_SSS_state_to_bytes_verifier(out_deg[0], k_tag, Nst);
}

// SBOX AFFINE
static void aes_SS_sbox_eval_prover(bfSSS_t** state_deg7, const uint8_t* state_bits,
                                    bfSSS_t* state_bits_tag, unsigned int Nst) {

  const unsigned int Nstbits  = 32 * Nst;
  const unsigned int Nstbytes = Nstbits / 8;

  bfSSS_t* state_conj     = BFSSS_ALLOC(Nstbits);
  bfSSS_t* state_conj_tag = BFSSS_ALLOC(Nstbits);

  aes_SSS_f256_f2_conjugates_1(state_conj, state_bits, Nst);
  aes_SSS_f256_f2_conjugates_SSS(state_conj_tag, state_bits_tag, Nst);

  // line 3
  bfSSS_t zeta[9];

  // line 5
  for (unsigned int i = 0; i <= 8; i++) {
    bfSSS_byte_combine_bits(&zeta[i], phi[i]);
  }

  for (unsigned int j = 0; j < Nstbytes; j++) {
    bfSSS_t p1_deg[3][4];
    bfSSS_t f1_deg[2][4];
    bfSSS_t p2_deg[5][2];
    bfSSS_t f2_deg[4][2];

    for (unsigned int i = 0; i <= 4; i++) {
      for (unsigned int m = 0; m < 2; m++) {
        p2_deg[i][m] = bfSSS_zero();
      }
    }
    for (unsigned int i = 0; i <= 3; i++) {
      for (unsigned int m = 0; m < 2; m++) {
        f2_deg[i][m] = bfSSS_zero();
      }
    }

    // line 8
    for (unsigned int i = 0; i < 4; i++) {
      bfSSS_mul(&p1_deg[0][i], &state_conj_tag[j * 8 + i * 2],
                &state_conj_tag[j * 8 + (i * 2 + 1)]); // deg-0 * deg-0

      bfSSS_t tmp;
      bfSSS_mul(&tmp, &state_conj[j * 8 + i * 2],
                &state_conj_tag[j * 8 + (i * 2 + 1)]); // deg-1 * deg-0
      bfSSS_mul(&p1_deg[1][i], &state_conj_tag[j * 8 + i * 2],
                &state_conj[j * 8 + (i * 2 + 1)]); // deg-0 * deg-1
      bfSSS_add(&p1_deg[1][i], &p1_deg[1][i], &tmp);

      bfSSS_mul(&p1_deg[2][i], &state_conj[j * 8 + i * 2],
                &state_conj[j * 8 + (i * 2 + 1)]); // deg-1 * deg-1

      bfSSS_t prod_1_deg[2], prod_2_deg[2];
      bfSSS_mul(&prod_1_deg[0], &zeta[i * 2],
                &state_conj_tag[j * 8 + (i * 2 + 1)]); // deg-0 * deg-0
      bfSSS_mul(&prod_2_deg[0], &zeta[i * 2 + 1],
                &state_conj_tag[j * 8 + (i * 2)]);                               // deg-0 * deg-0
      bfSSS_mul(&prod_1_deg[1], &zeta[i * 2], &state_conj[j * 8 + (i * 2 + 1)]); // deg-0 * deg-1
      bfSSS_mul(&prod_2_deg[1], &zeta[i * 2 + 1], &state_conj[j * 8 + (i * 2)]); // deg-0 * deg-1

      bfSSS_add(&f1_deg[0][i], &prod_1_deg[0], &prod_2_deg[0]); // deg-0
      bfSSS_add(&f1_deg[1][i], &prod_1_deg[1], &prod_2_deg[1]); // deg-1
    }

    for (unsigned int i = 0; i < 2; i++) {
      for (unsigned int m = 0; m <= 2; m++) {
        for (unsigned int n = 0; n <= 2; n++) {
          bfSSS_t tmp;
          bfSSS_mul(&tmp, &p1_deg[m][2 * i], &p1_deg[n][2 * i + 1]);
          bfSSS_add_inplace(&p2_deg[m + n][i], &tmp);
        }
      }

      bfSSS_t tmp;
      // first product
      for (unsigned int m = 0; m <= 1; m++) {
        for (unsigned int n = 0; n <= 2; n++) {
          bfSSS_mul(&tmp, &f1_deg[m][2 * i], &p1_deg[n][2 * i + 1]);
          bfSSS_add_inplace(&f2_deg[m + n][i], &tmp);
        }
      }

      // second product
      for (unsigned int m = 0; m <= 1; m++) {
        for (unsigned int n = 0; n <= 2; n++) {
          bfSSS_mul(&tmp, &f1_deg[m][2 * i + 1], &p1_deg[n][2 * i]);
          bfSSS_add_inplace(&f2_deg[m + n][i], &tmp);
        }
      }
    }

    // first product
    for (unsigned int m = 0; m <= 7; m++) {
      state_deg7[m][j] = bfSSS_zero();
    }
    bfSSS_t tmp;
    for (unsigned int m = 0; m <= 3; m++) {
      for (unsigned int n = 0; n <= 4; n++) {
        bfSSS_mul(&tmp, &f2_deg[m][0], &p2_deg[n][1]);
        bfSSS_add_inplace(&state_deg7[n + m][j], &tmp);
      }
    }

    // second product
    for (unsigned int m = 0; m <= 3; m++) {
      for (unsigned int n = 0; n <= 4; n++) {
        bfSSS_mul(&tmp, &f2_deg[m][1], &p2_deg[n][0]);
        bfSSS_add_inplace(&state_deg7[n + m][j], &tmp);
      }
    }

    bfSSS_add_inplace(&state_deg7[7][j], &zeta[8]);
  }

  faest_aligned_free(state_conj);
  faest_aligned_free(state_conj_tag);
}

static void aes_SS_sbox_eval_verifier(bfSSS_t* state_key, const bfSSS_t* state_bits_key,
                                      const bfSSS_t* delta_i, unsigned int Nst) {
  const unsigned int Nstbits  = 32 * Nst;
  const unsigned int Nstbytes = Nstbits / 8;

  bfSSS_t* state_conj_key = BFSSS_ALLOC(Nstbits);

  aes_SSS_f256_f2_conjugates_SSS(state_conj_key, state_bits_key, Nst);

  // line 3
  bfSSS_t zeta[9];

  // line 5
  for (unsigned int i = 0; i <= 8; i++) {
    bfSSS_byte_combine_bits(&zeta[i], phi[i]);
  }
  bfSSS_mul_inplace(&zeta[8], &delta_i[7]);

  // line 6
  for (unsigned int j = 0; j < Nstbytes; j++) {
    bfSSS_t p1_key[4];
    bfSSS_t f1_key[4];
    bfSSS_t p2_key[2];
    bfSSS_t f2_key[2];

    // line 8
    for (unsigned int i = 0; i < 4; i++) {
      // line 9
      bfSSS_mul(&p1_key[i], &state_conj_key[j * 8 + i * 2],
                &state_conj_key[j * 8 + (i * 2 + 1)]); // deg-1 * deg-1

      // line 10
      bfSSS_t prod_1_key, prod_2_key;
      bfSSS_mul(&prod_1_key, &zeta[i * 2], &state_conj_key[j * 8 + (i * 2 + 1)]); // deg-0 * deg-1
      bfSSS_mul(&prod_2_key, &zeta[i * 2 + 1], &state_conj_key[j * 8 + (i * 2)]); // deg-0 * deg-1

      bfSSS_add(&f1_key[i], &prod_1_key, &prod_2_key); // deg-1
    }

    // line 11
    for (unsigned int i = 0; i < 2; i++) {
      // line 12
      bfSSS_mul(&p2_key[i], &p1_key[2 * i], &p1_key[2 * i + 1]); // deg-2 * deg-2

      // line 13
      // first product
      bfSSS_mul(&f2_key[i], &f1_key[2 * i], &p1_key[2 * i + 1]); // deg-1 * deg-2
      // second product
      bfSSS_t tmp;
      bfSSS_mul(&tmp, &f1_key[2 * i + 1], &p1_key[2 * i]); // deg-1 * deg-2
      bfSSS_add_inplace(&f2_key[i], &tmp);                 // deg-3
    }

    // line 14
    // first product
    bfSSS_mul(&state_key[j], &f2_key[0], &p2_key[1]); // deg-3 * deg-4

    // second product
    bfSSS_t tmp;
    bfSSS_mul(&tmp, &f2_key[1], &p2_key[0]); // deg-3 * deg-4
    bfSSS_add_inplace(&state_key[j], &tmp);  // deg-7

    bfSSS_add_inplace(&state_key[j], &zeta[8]);
  }

  faest_aligned_free(state_conj_key);
}

// SHIFT ROWS
static void aes_SSS_shiftrows_prover(bfSSS_t** out_deg, const bfSSS_t** in_deg, unsigned int Nst) {

  for (unsigned int r = 0; r < 4; r++) {
    for (unsigned int c = 0; c < Nst; c++) {
      unsigned int i;
      if ((Nst != 8) || (r <= 1)) {
        i = 4 * ((c + r) % Nst) + r;
      } else {
        i = 4 * ((c + r + 1) % Nst) + r;
      }
      for (unsigned int m = 0; m <= 7; m++) {
        out_deg[m][4 * c + r] = in_deg[m][i];
      }
    }
  }
}

static void aes_SSS_shiftrows_verifier(bfSSS_t* out_key, const bfSSS_t* in_key, unsigned int Nst) {
  for (unsigned int r = 0; r < 4; r++) {
    for (unsigned int c = 0; c < Nst; c++) {
      if ((Nst != 8) || (r <= 1)) {
        out_key[4 * c + r] = in_key[(4 * ((c + r) % Nst) + r)];
      } else {
        out_key[4 * c + r] = in_key[(4 * ((c + r + 1) % Nst) + r)];
      }
    }
  }
}

// MIX COLOUMNS

#if FAEST_SSS_LAMBDA == 128
static const bf128_t bfSSS_bc_2 =
    BF128C(UINT64_C(0xa13fe8ac5560ce0d), UINT64_C(0x053d8555a9979a1c));
static const bf128_t bfSSS_bc_3 =
    BF128C(UINT64_C(0xa13fe8ac5560ce0c), UINT64_C(0x053d8555a9979a1c));
#elif FAEST_SSS_LAMBDA == 192
static const bf192_t bfSSS_bc_2 = BF192C(UINT64_C(0xccc8a3d56f389763), UINT64_C(0xe665d76c966ebdea),
                                         UINT64_C(0x310bc8140e6b3662));
static const bf192_t bfSSS_bc_3 = BF192C(UINT64_C(0xccc8a3d56f389762), UINT64_C(0xe665d76c966ebdea),
                                         UINT64_C(0x310bc8140e6b3662));
#elif FAEST_SSS_LAMBDA == 256
static const bf256_t bfSSS_bc_2 =
    BF256C(UINT64_C(0x969788420bdefee7), UINT64_C(0xbed68d38a0474e67), UINT64_C(0xdf229845f8f1e16a),
           UINT64_C(0x04c9a8cf20c95833));
static const bf256_t bfSSS_bc_3 =
    BF256C(UINT64_C(0x969788420bdefee6), UINT64_C(0xbed68d38a0474e67), UINT64_C(0xdf229845f8f1e16a),
           UINT64_C(0x04c9a8cf20c95833));
#else
#error "unexpected security parameter"
#endif

static void aes_SSS_mix_columns_prover(bfSSS_t** y_deg, const bfSSS_t** in_deg, unsigned int Nst) {
  //  ::2-4
  const bfSSS_t* v2 = &bfSSS_bc_2;
  const bfSSS_t* v3 = &bfSSS_bc_3;

  for (unsigned int c = 0; c < Nst; c++) {
    const unsigned int i0 = 4 * c;
    const unsigned int i1 = 4 * c + 1;
    const unsigned int i2 = 4 * c + 2;
    const unsigned int i3 = 4 * c + 3;

    bfSSS_t tmp1;
    bfSSS_t tmp2;
    // line 7
    for (int m = 0; m <= 7; m++) {
      bfSSS_mul(&tmp1, &in_deg[m][i0], v2);
      bfSSS_mul(&tmp2, &in_deg[m][i1], v3);
      bfSSS_add_inplace(&tmp1, &in_deg[m][i2]);
      bfSSS_add_inplace(&tmp2, &in_deg[m][i3]);
      bfSSS_add(&y_deg[m][i0], &tmp1, &tmp2);
    }

    // line 8
    for (int m = 0; m <= 7; m++) {
      bfSSS_mul(&tmp1, &in_deg[m][i1], v2);
      bfSSS_mul(&tmp2, &in_deg[m][i2], v3);
      bfSSS_add_inplace(&tmp1, &in_deg[m][i0]);
      bfSSS_add_inplace(&tmp2, &in_deg[m][i3]);
      bfSSS_add(&y_deg[m][i1], &tmp1, &tmp2);
    }

    // line 9
    for (int m = 0; m <= 7; m++) {
      bfSSS_mul(&tmp1, &in_deg[m][i2], v2);
      bfSSS_mul(&tmp2, &in_deg[m][i3], v3);
      bfSSS_add_inplace(&tmp1, &in_deg[m][i0]);
      bfSSS_add_inplace(&tmp2, &in_deg[m][i1]);
      bfSSS_add(&y_deg[m][i2], &tmp1, &tmp2);
    }

    // line 10
    for (int m = 0; m <= 7; m++) {
      bfSSS_mul(&tmp1, &in_deg[m][i3], v2);
      bfSSS_mul(&tmp2, &in_deg[m][i0], v3);
      bfSSS_add_inplace(&tmp1, &in_deg[m][i1]);
      bfSSS_add_inplace(&tmp2, &in_deg[m][i2]);
      bfSSS_add(&y_deg[m][i3], &tmp1, &tmp2);
    }
  }
}

static void aes_SSS_mix_columns_verifier(bfSSS_t* y_key, const bfSSS_t* in_key, unsigned int Nst) {
  //  ::2-4
  const bfSSS_t* v2 = &bfSSS_bc_2;
  const bfSSS_t* v3 = &bfSSS_bc_3;

  for (unsigned int c = 0; c < Nst; c++) {
    const unsigned int i0 = 4 * c;
    const unsigned int i1 = 4 * c + 1;
    const unsigned int i2 = 4 * c + 2;
    const unsigned int i3 = 4 * c + 3;

    bfSSS_t tmp1;
    bfSSS_t tmp2;

    // line 7
    bfSSS_mul(&tmp1, &in_key[i0], v2);
    bfSSS_mul(&tmp2, &in_key[i1], v3);
    bfSSS_add_inplace(&tmp1, &in_key[i2]);
    bfSSS_add_inplace(&tmp2, &in_key[i3]);
    bfSSS_add(&y_key[i0], &tmp1, &tmp2);

    // line 8
    bfSSS_mul(&tmp1, &in_key[i1], v2);
    bfSSS_mul(&tmp2, &in_key[i2], v3);
    bfSSS_add_inplace(&tmp1, &in_key[i0]);
    bfSSS_add_inplace(&tmp2, &in_key[i3]);
    bfSSS_add(&y_key[i1], &tmp1, &tmp2);

    // line 9
    bfSSS_mul(&tmp1, &in_key[i2], v2);
    bfSSS_mul(&tmp2, &in_key[i3], v3);
    bfSSS_add_inplace(&tmp1, &in_key[i0]);
    bfSSS_add_inplace(&tmp2, &in_key[i1]);
    bfSSS_add(&y_key[i2], &tmp1, &tmp2);

    // line 10
    bfSSS_mul(&tmp1, &in_key[i3], v2);
    bfSSS_mul(&tmp2, &in_key[i0], v3);
    bfSSS_add_inplace(&tmp1, &in_key[i1]);
    bfSSS_add_inplace(&tmp2, &in_key[i2]);
    bfSSS_add(&y_key[i3], &tmp1, &tmp2);
  }
}

// ADD ROUND KEY BYTES
static void aes_SSS_add_round_key_bytes_prover_degree_7(bfSSS_t** out_deg, const bfSSS_t** in_deg,
                                                        const bfSSS_t** k_deg, unsigned int Nst) {
  const unsigned int Nstbytes = Nst * 4;

  for (unsigned int m = 0; m <= 5; m++) {
    memcpy(out_deg[m], in_deg[m], sizeof(bfSSS_t) * Nstbytes);
  }
  for (unsigned int i = 0; i < Nstbytes; i++) {
    bfSSS_add(&out_deg[7][i], &in_deg[7][i], &k_deg[1][i]);
    bfSSS_add(&out_deg[6][i], &in_deg[6][i], &k_deg[0][i]);
  }
}

// Use shift_tag if key is degree-1 instead of degree-2
static void aes_SSS_add_round_key_bytes_verifier(bfSSS_t* y_key, const bfSSS_t* in_key,
                                                 const bfSSS_t* k_key, const bfSSS_t* delta_i,
                                                 unsigned int Nst) {
  const unsigned int Nstbytes = Nst * 4;

  for (unsigned int i = 0; i < Nstbytes; i++) {
    // Multiply tag by delta to align degrees
    bfSSS_t tmp;
    bfSSS_mul(&tmp, &k_key[i], &delta_i[6]);
    bfSSS_add(&y_key[i], &in_key[i], &tmp);
  }
}

// INVERSE SHIFT ROWS
static void aes_SSS_inverse_shiftrows_prover(uint8_t* out, bfSSS_t* out_tag, const uint8_t* in,
                                             const bfSSS_t* in_tag, unsigned int Nst) {
  for (unsigned int r = 0; r < 4; r++) {
    for (unsigned int c = 0; c < Nst; c++) {
      unsigned int i;
      if ((Nst != 8) || (r <= 1)) {
        i = 4 * ((c + Nst - r) % Nst) + r;
      } else {
        i = 4 * ((c + Nst - r - 1) % Nst) + r;
      }

      out[4 * c + r] = in[i];
      memcpy(&out_tag[8 * (4 * c + r)], &in_tag[8 * i], 8 * sizeof(bfSSS_t));
    }
  }
}

static void aes_SSS_inverse_shiftrows_verifier(bfSSS_t* out_key, const bfSSS_t* in_key,
                                               unsigned int Nst) {
  for (unsigned int r = 0; r < 4; r++) {
    for (unsigned int c = 0; c < Nst; c++) {
      unsigned int i;
      if ((Nst != 8) || (r <= 1)) {
        i = 4 * ((c + Nst - r) % Nst) + r;
      } else {
        i = 4 * ((c + Nst - r - 1) % Nst) + r;
      }

      memcpy(&out_key[8 * (4 * c + r)], &in_key[8 * i], 8 * sizeof(bfSSS_t));
    }
  }
}

// BITWISE MIX COLUMNS
static void aes_SSS_bitwise_mix_column_prover(uint8_t* out, bfSSS_t* out_tag, const uint8_t* s,
                                              const bfSSS_t* s_tag, unsigned int Nst) {
  for (unsigned int c = 0; c < Nst; c++) {
    // ::2-3
    const uint8_t* a_bits     = &s[32 * c / 8];
    const bfSSS_t* a_bits_tag = &s_tag[32 * c];

    uint8_t b_bits[4];
    bfSSS_t b_bits_tag[4 * 8];

    // ::1
    for (unsigned int r = 0; r < 4; r++) {
      // :5
      const uint8_t high_bit_mask = -(a_bits[r] >> 7);
      b_bits[r]                   = (a_bits[r] << 1) ^ (high_bit_mask & UINT8_C(0x1b));

      b_bits_tag[r * 8 + 0] = a_bits_tag[r * 8 + 7];
      bfSSS_add(&b_bits_tag[r * 8 + 1], &a_bits_tag[r * 8 + 0], &a_bits_tag[r * 8 + 7]);
      b_bits_tag[r * 8 + 2] = a_bits_tag[r * 8 + 1];
      bfSSS_add(&b_bits_tag[r * 8 + 3], &a_bits_tag[r * 8 + 2], &a_bits_tag[r * 8 + 7]);
      bfSSS_add(&b_bits_tag[r * 8 + 4], &a_bits_tag[r * 8 + 3], &a_bits_tag[r * 8 + 7]);
      memcpy(&b_bits_tag[r * 8 + 5], &a_bits_tag[r * 8 + 4], 3 * sizeof(bfSSS_t));
    }

    out[c * 4]     = b_bits[0] ^ a_bits[3] ^ a_bits[2] ^ b_bits[1] ^ a_bits[1];
    out[c * 4 + 1] = b_bits[1] ^ a_bits[0] ^ a_bits[3] ^ b_bits[2] ^ a_bits[2];
    out[c * 4 + 2] = b_bits[2] ^ a_bits[1] ^ a_bits[0] ^ b_bits[3] ^ a_bits[3];
    out[c * 4 + 3] = b_bits[3] ^ a_bits[2] ^ a_bits[1] ^ b_bits[0] ^ a_bits[0];

    for (unsigned int i_bit = 0; i_bit < 8; ++i_bit) {
      bfSSS_add(&out_tag[8 * (c * 4) + i_bit], &b_bits_tag[0 * 8 + i_bit],
                &a_bits_tag[3 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4) + i_bit], &a_bits_tag[2 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4) + i_bit], &b_bits_tag[1 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4) + i_bit], &a_bits_tag[1 * 8 + i_bit]);

      bfSSS_add(&out_tag[8 * (c * 4 + 1) + i_bit], &b_bits_tag[1 * 8 + i_bit],
                &a_bits_tag[0 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 1) + i_bit], &a_bits_tag[3 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 1) + i_bit], &b_bits_tag[2 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 1) + i_bit], &a_bits_tag[2 * 8 + i_bit]);

      bfSSS_add(&out_tag[8 * (c * 4 + 2) + i_bit], &b_bits_tag[2 * 8 + i_bit],
                &a_bits_tag[1 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 2) + i_bit], &a_bits_tag[0 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 2) + i_bit], &b_bits_tag[3 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 2) + i_bit], &a_bits_tag[3 * 8 + i_bit]);

      bfSSS_add(&out_tag[8 * (c * 4 + 3) + i_bit], &b_bits_tag[3 * 8 + i_bit],
                &a_bits_tag[2 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 3) + i_bit], &a_bits_tag[1 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 3) + i_bit], &b_bits_tag[0 * 8 + i_bit]);
      bfSSS_add_inplace(&out_tag[8 * (c * 4 + 3) + i_bit], &a_bits_tag[0 * 8 + i_bit]);
    }
  }
}

static void aes_SSS_bitwise_mix_column_verifier(bfSSS_t* out_key, bfSSS_t* s_keys_key,
                                                unsigned int Nst) {
  for (unsigned int c = 0; c < Nst; c++) {
    // ::2-3
    const bfSSS_t* a_bits_key = &s_keys_key[32 * c];

    // ::1
    bfSSS_t b_bits_key[4 * 8];
    for (unsigned int r = 0; r < 4; r++) {
      // :5
      b_bits_key[r * 8 + 0] = a_bits_key[r * 8 + 7];
      bfSSS_add(&b_bits_key[r * 8 + 1], &a_bits_key[r * 8 + 0], &a_bits_key[r * 8 + 7]);
      b_bits_key[r * 8 + 2] = a_bits_key[r * 8 + 1];
      bfSSS_add(&b_bits_key[r * 8 + 3], &a_bits_key[r * 8 + 2], &a_bits_key[r * 8 + 7]);
      bfSSS_add(&b_bits_key[r * 8 + 4], &a_bits_key[r * 8 + 3], &a_bits_key[r * 8 + 7]);
      memcpy(&b_bits_key[r * 8 + 5], &a_bits_key[r * 8 + 4], 3 * sizeof(bfSSS_t));
    }

    // ::6-9
    for (unsigned int i_bit = 0; i_bit < 8; ++i_bit) {
      bfSSS_add(&out_key[8 * (c * 4) + i_bit], &b_bits_key[0 * 8 + i_bit],
                &a_bits_key[3 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4) + i_bit], &a_bits_key[2 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4) + i_bit], &b_bits_key[1 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4) + i_bit], &a_bits_key[1 * 8 + i_bit]);

      bfSSS_add(&out_key[8 * (c * 4 + 1) + i_bit], &b_bits_key[1 * 8 + i_bit],
                &a_bits_key[0 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 1) + i_bit], &a_bits_key[3 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 1) + i_bit], &b_bits_key[2 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 1) + i_bit], &a_bits_key[2 * 8 + i_bit]);

      bfSSS_add(&out_key[8 * (c * 4 + 2) + i_bit], &b_bits_key[2 * 8 + i_bit],
                &a_bits_key[1 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 2) + i_bit], &a_bits_key[0 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 2) + i_bit], &b_bits_key[3 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 2) + i_bit], &a_bits_key[3 * 8 + i_bit]);

      bfSSS_add(&out_key[8 * (c * 4 + 3) + i_bit], &b_bits_key[3 * 8 + i_bit],
                &a_bits_key[2 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 3) + i_bit], &a_bits_key[1 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 3) + i_bit], &b_bits_key[0 * 8 + i_bit]);
      bfSSS_add_inplace(&out_key[8 * (c * 4 + 3) + i_bit], &a_bits_key[0 * 8 + i_bit]);
    }
  }
}

// CONSTANT TO VOLE
static void constant_to_vole_SSS_prover(bfSSS_t* tag, unsigned int n) {
  // the val stay the same as the val is a pub const!
  // for constant values the tag is zero
  memset(tag, 0, sizeof(bfSSS_t) * n);
}

static void constant_to_vole_SSS_verifier(bfSSS_t* key, const uint8_t* val, const bfSSS_t* delta,
                                          unsigned int n) {
  for (unsigned int i = 0; i < n; i++) {
    bfSSS_mul_bit(&key[i], delta, ptr_get_bit(val, i));
  }
}

// // INVERSE AFFINE
static void aes_SSS_inverse_affine_byte_prover(uint8_t* y_bits, bfSSS_t* y_bits_tag,
                                               const uint8_t x_bits, const bfSSS_t* x_bits_tag) {
  *y_bits = rotr8(x_bits, 7) ^ rotr8(x_bits, 5) ^ rotr8(x_bits, 2) ^ 0x5;

  for (unsigned int bit_i = 0; bit_i < 8; bit_i++) {
    bfSSS_add(&y_bits_tag[bit_i], &x_bits_tag[(bit_i - 1 + 8) % 8],
              &x_bits_tag[(bit_i - 3 + 8) % 8]);
    bfSSS_add_inplace(&y_bits_tag[bit_i], &x_bits_tag[(bit_i - 6 + 8) % 8]);
  }
}

static void aes_SSS_inverse_affine_prover(uint8_t* y, bfSSS_t* y_tag, const uint8_t* x,
                                          const bfSSS_t* x_tag, unsigned int Nst) {
  const unsigned int Nstbytes = Nst * 4;

  for (unsigned int i = 0; i < Nstbytes; i++) {
    aes_SSS_inverse_affine_byte_prover(y + i, y_tag + i * 8, x[i], x_tag + i * 8);
  }
}

static void aes_SSS_inverse_sbox_eval_prover(bfSSS_t** b_deg, const uint8_t* s_dash_dash,
                                             const bfSSS_t* s_dash_dash_tag, unsigned int Nst) {
  const unsigned int Nstbytes = Nst * 4;

  uint8_t* s     = malloc(Nstbytes);
  bfSSS_t* s_tag = BFSSS_ALLOC(Nstbytes * 8);
  aes_SSS_inverse_affine_prover(s, s_tag, s_dash_dash, s_dash_dash_tag, Nst);

  bfSSS_t* state_conj     = BFSSS_ALLOC(Nstbytes * 8);
  bfSSS_t* state_conj_tag = BFSSS_ALLOC(Nstbytes * 8);

  aes_SSS_f256_f2_conjugates_1(state_conj, s, Nst);
  aes_SSS_f256_f2_conjugates_SSS(state_conj_tag, s_tag, Nst);

  for (unsigned int j = 0; j < Nstbytes; j++) {
    b_deg[0][j] = state_conj_tag[j * 8 + 1];
    b_deg[1][j] = state_conj[j * 8 + 1];
    for (unsigned int m = 2; m <= 7; m++) {
      b_deg[m][j] = bfSSS_zero();
    }

    for (unsigned int i = 2; i <= 7; i++) {
      const bfSSS_t* t = &state_conj_tag[j * 8 + i];
      const bfSSS_t* v = &state_conj[j * 8 + i];

      // Temporary holder
      bfSSS_t b_deg_tmp_v[8];
      bfSSS_t b_deg_tmp_tag[8];
      for (unsigned int m = 0; m <= 7; m++) {
        b_deg_tmp_v[m]   = bfSSS_zero();
        b_deg_tmp_tag[m] = bfSSS_zero();
      }

      for (unsigned int m = 0; m < i; m++) {
        bfSSS_mul(&b_deg_tmp_tag[m], &b_deg[m][j], t);   // deg-n * deg-0  -> deg-n
        bfSSS_mul(&b_deg_tmp_v[m + 1], &b_deg[m][j], v); // deg-n * deg-1  -> deg-n+1
      }
      for (unsigned int m = 0; m <= 7; m++) {
        bfSSS_add(&b_deg[m][j], &b_deg_tmp_tag[m], &b_deg_tmp_v[m]);
      }
    }
  }

  free(s);
  faest_aligned_free(s_tag);
  faest_aligned_free(state_conj);
  faest_aligned_free(state_conj_tag);
}

static void aes_SSS_inverse_affine_byte_verifier(bfSSS_t* y_bits_key, const bfSSS_t* x_bits_key,
                                                 const bfSSS_t* delta) {
  for (unsigned int bit_i = 0; bit_i < 8; bit_i++) {
    bfSSS_add(&y_bits_key[bit_i], &x_bits_key[(bit_i - 1 + 8) % 8],
              &x_bits_key[(bit_i - 3 + 8) % 8]);
    bfSSS_add_inplace(&y_bits_key[bit_i], &x_bits_key[(bit_i - 6 + 8) % 8]);
  }

  bfSSS_add_inplace(&y_bits_key[0], delta);
  bfSSS_add_inplace(&y_bits_key[2], delta);
}

static void aes_SSS_inverse_affine_verifier(bfSSS_t* y_key, const bfSSS_t* x_key,
                                            const bfSSS_t* delta, unsigned int Nst) {
  const unsigned int Nstbytes = Nst * 4;

  for (unsigned int i = 0; i < Nstbytes; i++) {
    aes_SSS_inverse_affine_byte_verifier(y_key + i * 8, x_key + i * 8, delta);
  }
}

static void aes_SSS_inverse_sbox_eval_verifier(bfSSS_t* b_key, const bfSSS_t* s_dash_dash_tag,
                                               const bfSSS_t* delta_i, unsigned int Nst) {

  const unsigned int Nstbytes = Nst * 4;

  bfSSS_t* s_tag = BFSSS_ALLOC(Nstbytes * 8);
  aes_SSS_inverse_affine_verifier(s_tag, s_dash_dash_tag, &delta_i[1], Nst);

  bfSSS_t* state_conj_tag = BFSSS_ALLOC(Nstbytes * 8);
  aes_SSS_f256_f2_conjugates_SSS(state_conj_tag, s_tag, Nst);

  for (unsigned int j = 0; j < Nstbytes; j++) {
    b_key[j] = state_conj_tag[j * 8 + 1];
    for (unsigned int i = 2; i <= 7; i++) {
      bfSSS_mul_inplace(&b_key[j], &state_conj_tag[j * 8 + i]);
    }
  }

  faest_aligned_free(s_tag);
  faest_aligned_free(state_conj_tag);
}

// EncSctrnts internal functions end!!

static bfSSS_t* shrink_V_SSS(uint8_t** v, unsigned int ell) {
  // v was already transposed in calling code, so just load the values
  bfSSS_t* new_v = BFSSS_ALLOC(ell);
  assert(new_v);
  for (unsigned int row = 0; row != ell; ++row) {
    bfSSS_load(&new_v[row], v[row]);
  }
  return new_v;
}

// // KEY EXP FWD / BKWD
static void aes_SSS_keyexp_backward_prover(uint8_t* y, bfSSS_t* y_tag, const uint8_t* x,
                                           const bfSSS_t* x_tag, const uint8_t* key,
                                           const bfSSS_t* key_tag, const faest_paramset_t* params) {
  const unsigned int Ske = params->Ske;

  // ::3
  unsigned int iwd = 0;
  // ::5-6
  for (unsigned int j = 0; j < Ske; j++) {
    // ::7-10
    // for the witness
    uint8_t x_tilde = x[j] ^ key[(iwd + (j % 4) * 8) / 8];
    // for the tags of each witness bit
    bfSSS_t x_tilde_tag[8];
    for (unsigned int bit_i = 0; bit_i < 8; bit_i++) {
      bfSSS_add(&x_tilde_tag[bit_i], &x_tag[j * 8 + bit_i], &key_tag[iwd + (j % 4) * 8 + bit_i]);
    }

    if (j % RCON_EVERY == 0) {
      // adding round constant to the witness
      x_tilde ^= Rcon[j / RCON_EVERY];
    }

    // ::11
    aes_SSS_inverse_affine_byte_prover(y + j, y_tag + 8 * j, x_tilde, x_tilde_tag);

    // ::12-16 lines only relavant for aes-128
    if (j % 4 == 3) {
      iwd += IWD_INC;
    }
  }
}

static void aes_SSS_keyexp_backward_verifier(bfSSS_t* y_key, const bfSSS_t* x_key,
                                             const bfSSS_t* key_key, const bfSSS_t* delta,
                                             const faest_paramset_t* params) {
  const unsigned int Ske = params->Ske;

  // ::2
  bfSSS_t x_tilde_key[8];
  // ::3
  unsigned int iwd = 0;
  // ::5-6
  for (unsigned int j = 0; j < Ske; j++) {
    // ::7
    for (unsigned int bit_i = 0; bit_i < 8; bit_i++) {
      bfSSS_add(&x_tilde_key[bit_i], &x_key[j * 8 + bit_i],
                &key_key[iwd + (j % 4) * 8 + bit_i]); // for the tags of each witness bit
      // ::8-10
      if (j % RCON_EVERY == 0) {
        bfSSS_t rcon_key;
        const uint8_t c = get_bit(Rcon[j / RCON_EVERY], bit_i);
        constant_to_vole_SSS_verifier(&rcon_key, &c, delta, 1);
        bfSSS_add_inplace(&x_tilde_key[bit_i], &rcon_key);
      }
    }
    // ::11
    aes_SSS_inverse_affine_byte_verifier(y_key + 8 * j, x_tilde_key, delta);

    // ::12-16 lines only relavant for aes-128
    if (j % 4 == 3) {
      iwd += IWD_INC;
    }
  }
}

static void aes_SSS_keyexp_forward_prover(uint8_t* y, bfSSS_t* y_tag, const uint8_t* w,
                                          const bfSSS_t* w_tag) {
  // ::1-2
  memcpy(y, w, FAEST_SSS_LAMBDA / 8);
  memcpy(y_tag, w_tag, FAEST_SSS_LAMBDA * sizeof(bfSSS_t));

  // ::3
  unsigned int i_wd = FAEST_SSS_LAMBDA;
  // ::4-10
  for (unsigned int j = FAEST_SSS_NK; j < 4 * (FAEST_SSS_R + 1); j++) {
    // ::5
    if ((j % FAEST_SSS_NK == 0) || ((FAEST_SSS_NK > 6) && (j % FAEST_SSS_NK == 4))) {
      // ::6
      memcpy(&y[32 * j / 8], &w[i_wd / 8], 32 / 8);
      memcpy(&y_tag[32 * j], &w_tag[i_wd], 32 * sizeof(bfSSS_t));
      // ::7
      i_wd += 32;
      // ::8
    } else {
      // ::9-10
      xor_u8_array(&y[32 * (j - FAEST_SSS_NK) / 8], &y[32 * (j - 1) / 8], &y[32 * j / 8], 32 / 8);
      for (unsigned int word_idx = 0; word_idx < 32; word_idx++) {
        bfSSS_add(&y_tag[32 * j + word_idx], &y_tag[32 * (j - FAEST_SSS_NK) + word_idx],
                  &y_tag[32 * (j - 1) + word_idx]);
      }
    }
  }
}

static void aes_SSS_keyexp_forward_verifier(bfSSS_t* y_key, const bfSSS_t* w_key) {
  // ::1-2
  memcpy(y_key, w_key, FAEST_SSS_LAMBDA * sizeof(bfSSS_t));

  // ::3
  unsigned int i_wd = FAEST_SSS_LAMBDA;
  // ::4-10
  for (unsigned int j = FAEST_SSS_NK; j < 4 * (FAEST_SSS_R + 1); j++) {
    // ::5
    if ((j % FAEST_SSS_NK == 0) || ((FAEST_SSS_NK > 6) && (j % FAEST_SSS_NK == 4))) {
      // ::6
      memcpy(&y_key[32 * j], &w_key[i_wd], 32 * sizeof(bfSSS_t));
      // ::7
      i_wd += 32; // 32 bits -> 4 words
      // ::8
    } else {
      // ::9-10
      for (unsigned int word_idx = 0; word_idx < 32; word_idx++) {
        bfSSS_add(&y_key[32 * j + word_idx], &y_key[32 * (j - FAEST_SSS_NK) + word_idx],
                  &y_key[32 * (j - 1) + word_idx]);
      }
    }
  }
}

// // KEY EXP CSTRNTS
static void aes_SSS_expkey_constraints_prover(zk_hash_SSS_7_ctx* hasher, uint8_t* k, bfSSS_t* k_tag,
                                              const uint8_t* w, const bfSSS_t* w_tag,
                                              const faest_paramset_t* params) {
  const unsigned int Ske = params->Ske;

  // line 1
  aes_SSS_keyexp_forward_prover(k, k_tag, w, w_tag);
  // line 2
  uint8_t* w_flat     = malloc(Ske);
  bfSSS_t* w_flat_tag = BFSSS_ALLOC(8 * Ske);
  assert(w_flat);
  assert(w_flat_tag);
  aes_SSS_keyexp_backward_prover(w_flat, w_flat_tag, w + FAEST_SSS_LAMBDA / 8,
                                 w_tag + FAEST_SSS_LAMBDA, k, k_tag, params);

  // line 5
  for (unsigned int j = 0, iwd = 32 * (FAEST_SSS_NK - 1); j < Ske; j += 4, iwd += IWD_INC) {

    for (unsigned int r = 0; r < 4; r++) {
#if FAEST_SSS_LAMBDA == 256
      // line 10
      unsigned int r_prime = r;

      if (j % 8 == 0) {
        r_prime = (r + 1) % 4;
      }
#else
      unsigned int r_prime = (r + 1) % 4;
#endif
      bfSSS_t k_hat;    // expanded key witness
      bfSSS_t w_hat;    // inverse output
      bfSSS_t k_hat_sq; // expanded key witness sq
      bfSSS_t w_hat_sq; // inverse output sq

      bfSSS_t k_hat_tag;    // expanded key witness tag
      bfSSS_t w_hat_tag;    // inverse output tag
      bfSSS_t k_hat_tag_sq; // expanded key tag sq
      bfSSS_t w_hat_tag_sq; // inverser output tag sq

      // line 12
      bfSSS_byte_combine_bits(&k_hat, k[(iwd + 8 * r_prime) / 8]);       // lifted key witness
      bfSSS_byte_combine_bits_sq(&k_hat_sq, k[(iwd + 8 * r_prime) / 8]); // lifted key witness sq

      bfSSS_byte_combine_bits(&w_hat, w_flat[(8 * j + 8 * r) / 8]);       // lifted output
      bfSSS_byte_combine_bits_sq(&w_hat_sq, w_flat[(8 * j + 8 * r) / 8]); // lifted output sq

      // done by both prover and verifier
      bfSSS_byte_combine(&k_hat_tag, k_tag + (iwd + 8 * r_prime));       // lifted key tag
      bfSSS_byte_combine_sq(&k_hat_tag_sq, k_tag + (iwd + 8 * r_prime)); // lifted key tag sq

      bfSSS_byte_combine(&w_hat_tag, w_flat_tag + ((8 * j + 8 * r))); // lifted output tag
      bfSSS_byte_combine_sq(&w_hat_tag_sq,
                            w_flat_tag + (8 * j + 8 * r)); // lifted output tag sq

      // line 19
      bfSSS_t v1;
      bfSSS_t tmp;
      bfSSS_mul(&v1, &k_hat_sq, &w_hat_tag);
      bfSSS_mul(&tmp, &k_hat_tag_sq, &w_hat);
      bfSSS_add_inplace(&v1, &k_hat_tag);
      bfSSS_add_inplace(&v1, &tmp);
      bfSSS_mul(&tmp, &k_hat_tag_sq, &w_hat_tag);
      zk_hash_SSS_7_raise_and_update(hasher, &tmp, &v1);

      bfSSS_mul(&v1, &k_hat, &w_hat_tag_sq);
      bfSSS_mul(&tmp, &k_hat_tag, &w_hat_sq);
      bfSSS_add_inplace(&v1, &w_hat_tag);
      bfSSS_add_inplace(&v1, &tmp);
      bfSSS_mul(&tmp, &k_hat_tag, &w_hat_tag_sq);
      zk_hash_SSS_7_raise_and_update(hasher, &tmp, &v1);
    }
  }
  faest_aligned_free(w_flat_tag);
  free(w_flat);
}

static void aes_SSS_expkey_constraints_verifier(zk_hash_SSS_ctx* hasher, bfSSS_t* k_key,
                                                const bfSSS_t* w_key, const bfSSS_t* delta_i,
                                                const faest_paramset_t* params) {
  const unsigned int Ske = params->Ske;

  // ::1
  aes_SSS_keyexp_forward_verifier(k_key, w_key);
  // ::2
  bfSSS_t* w_flat_key = BFSSS_ALLOC(8 * Ske);
  assert(w_flat_key);
  aes_SSS_keyexp_backward_verifier(w_flat_key, w_key + FAEST_SSS_LAMBDA, k_key, &delta_i[1],
                                   params);

  // ::3-5,::7
  for (unsigned int j = 0, iwd = 32 * (FAEST_SSS_NK - 1); j < Ske; j += 4, iwd += IWD_INC) {
    // ::9
    for (unsigned int r = 0; r < 4; r++) {
#if FAEST_SSS_LAMBDA == 256
      // ::10
      unsigned int r_prime = r;
      // ::11
      if (j % 8 == 0) {
        r_prime = (r + 1) % 4;
      }
#else
      unsigned int r_prime = (r + 1) % 4;
#endif
      bfSSS_t k_hat_key;    // expanded key witness tag
      bfSSS_t w_hat_key;    // inverse output tag
      bfSSS_t k_hat_key_sq; // expanded key tag sq
      bfSSS_t w_hat_key_sq; // inverser output tag sq

      // ::12-15
      bfSSS_byte_combine(&k_hat_key, k_key + (iwd + 8 * r_prime));       // lifted key tag
      bfSSS_byte_combine_sq(&k_hat_key_sq, k_key + (iwd + 8 * r_prime)); // lifted key tag sq

      bfSSS_byte_combine(&w_hat_key, w_flat_key + ((8 * j + 8 * r))); // lifted output tag
      bfSSS_byte_combine_sq(&w_hat_key_sq,
                            w_flat_key + (8 * j + 8 * r)); // lifted output tag sq

      // ::17-20
      // also raise degree
      bfSSS_t v;
      bfSSS_t tmp;
      bfSSS_mul(&v, &k_hat_key_sq, &w_hat_key);
      bfSSS_mul(&tmp, &delta_i[1], &k_hat_key);
      bfSSS_add_inplace(&v, &tmp);
      bfSSS_mul_inplace(&v, &delta_i[5]);
      zk_hash_SSS_update(hasher, &v);

      bfSSS_mul(&v, &k_hat_key, &w_hat_key_sq);
      bfSSS_mul(&tmp, &delta_i[1], &w_hat_key);
      bfSSS_add_inplace(&v, &tmp);
      bfSSS_mul_inplace(&v, &delta_i[5]);
      zk_hash_SSS_update(hasher, &v);
    }
  }
  faest_aligned_free(w_flat_key);
}

// // ENC CSTRNTS
static void aes_SSS_enc_constraints_prover(zk_hash_SSS_7_ctx* hasher, const uint8_t* owf_in,
                                           const bfSSS_t* owf_in_tag, const uint8_t* owf_out,
                                           const bfSSS_t* owf_out_tag, const uint8_t* w,
                                           const bfSSS_t* w_tag, const uint8_t* k,
                                           const bfSSS_t* k_tag, unsigned int Nst) {
  const unsigned int Nstbits  = 32 * Nst;
  const unsigned int Nstbytes = Nstbits / 8;

  /// line 1
  uint8_t* state_bits     = malloc(4 * Nstbytes);
  bfSSS_t* state_bits_tag = BFSSS_ALLOC(Nstbits + 5 * 8 * Nstbytes + 3 * Nstbits);
  assert(state_bits);
  assert(state_bits_tag);

  aes_SSS_add_round_key_prover(state_bits, state_bits_tag, owf_in, owf_in_tag, k, k_tag, Nst);

  uint8_t* s_tilde         = &state_bits[Nstbytes];
  bfSSS_t* s_tilde_tag     = &state_bits_tag[Nstbits + 5 * 8 * Nstbytes];
  uint8_t* s_dash_dash     = &state_bits[2 * Nstbytes];
  bfSSS_t* s_dash_dash_tag = &state_bits_tag[Nstbits + 5 * 8 * Nstbytes + Nstbits];

  bfSSS_t* b_deg[8];
  for (unsigned int m = 0; m <= 7; m++) {
    b_deg[m] = BFSSS_ALLOC(Nstbytes);
    for (unsigned n = 0; n < Nstbytes; n++) {
      b_deg[m][n] = bfSSS_zero();
    }
  }
  uint8_t* s     = &state_bits[3 * Nstbytes];
  bfSSS_t* s_tag = &state_bits_tag[Nstbits + 5 * 8 * Nstbytes + 2 * Nstbits];

  // line 2
  for (unsigned int r = 0; r < FAEST_SSS_R / 2; r++) {
    // line 3
    bfSSS_t* state_deg7[8];
    for (unsigned int m = 0; m <= 7; m++) {
      state_deg7[m] = BFSSS_ALLOC(Nstbytes);
    }

    // line 4
    aes_SS_sbox_eval_prover(state_deg7, state_bits, state_bits_tag, Nst);

    // line 5
    bfSSS_t* state_deg7_tmp[8];
    for (unsigned int m = 0; m <= 7; m++) {
      state_deg7_tmp[m] = BFSSS_ALLOC(Nstbytes);
    }
    aes_SSS_shiftrows_prover(state_deg7_tmp, (const bfSSS_t**)state_deg7, Nst);

    // line 6
    aes_SSS_mix_columns_prover(state_deg7, (const bfSSS_t**)state_deg7_tmp, Nst);

    // line 7
    bfSSS_t* k_deg[2];
    for (unsigned int m = 0; m <= 1; m++) {
      k_deg[m] = BFSSS_ALLOC(Nstbytes);
    }
    aes_SSS_state_to_bytes_prover(k_deg, k + (2 * r + 1) * Nstbytes, k_tag + (2 * r + 1) * Nstbits,
                                  Nst);
    aes_SSS_add_round_key_bytes_prover_degree_7(state_deg7_tmp, (const bfSSS_t**)state_deg7,
                                                (const bfSSS_t**)k_deg, Nst);

    // line 10
    if (r == FAEST_SSS_R / 2 - 1) {
      aes_SSS_add_round_key_prover(s_tilde, s_tilde_tag, owf_out, owf_out_tag,
                                   k + FAEST_SSS_R * Nstbytes, k_tag + FAEST_SSS_R * Nstbits, Nst);
    } else {
      // line 11
      memcpy(s_tilde, &w[(Nstbits * r) / 8], Nstbytes);
      memcpy(s_tilde_tag, &w_tag[(Nstbits * r)], Nstbits * sizeof(bfSSS_t));
    }

    // line 15
    aes_SSS_inverse_shiftrows_prover(s_dash_dash, s_dash_dash_tag, s_tilde, s_tilde_tag, Nst);
    // line 16
    aes_SSS_inverse_sbox_eval_prover(b_deg, s_dash_dash, s_dash_dash_tag, Nst);

    // line 17
    bfSSS_t tmp[8];
    for (unsigned int byte_i = 0; byte_i < Nstbytes; byte_i++) {
      for (unsigned int m = 0; m <= 7; m++) {
        bfSSS_add(&tmp[m], &b_deg[m][byte_i], &state_deg7_tmp[m][byte_i]);
      }
      // NOTE: getting the z's
      zk_hash_SSS_7_update(hasher, tmp);
    }

    for (unsigned int m = 0; m <= 7; m++) {
      faest_aligned_free(state_deg7_tmp[m]);
    }
    for (unsigned int m = 0; m <= 7; m++) {
      faest_aligned_free(state_deg7[m]);
    }
    for (unsigned int m = 0; m <= 1; m++) {
      faest_aligned_free(k_deg[m]);
    }

    // line 21
    if (r != (FAEST_SSS_R / 2) - 1) {
      uint8_t* tmp_state     = s;
      bfSSS_t* tmp_state_tag = s_tag;
      aes_SSS_bitwise_mix_column_prover(tmp_state, tmp_state_tag, s_tilde, s_tilde_tag, Nst);
      aes_SSS_add_round_key_prover(state_bits, state_bits_tag, tmp_state, tmp_state_tag,
                                   k + (2 * r + 2) * Nstbytes, k_tag + (2 * r + 2) * Nstbits, Nst);
    }
  }

  for (unsigned int m = 0; m <= 7; m++) {
    faest_aligned_free(b_deg[m]);
  }

  faest_aligned_free(state_bits_tag);
  free(state_bits);
}

static void aes_SSS_enc_constraints_verifier(zk_hash_SSS_ctx* hasher, const bfSSS_t* owf_in_key,
                                             const bfSSS_t* owf_out_key, const bfSSS_t* w_key,
                                             const bfSSS_t* rkeys_key, const bfSSS_t* delta_i,
                                             unsigned int Nst) {
  const unsigned int Nstbits  = 32 * Nst;
  const unsigned int Nstbytes = Nstbits / 8;

  /// line 1
  bfSSS_t* state_bits_key = BFSSS_ALLOC(Nstbits + 5 * 8 * Nstbytes + 3 * Nstbits);
  aes_SSS_add_round_key_verifier(state_bits_key, owf_in_key, rkeys_key, Nst);

  bfSSS_t* s_tilde_key     = &state_bits_key[Nstbits + 5 * 8 * Nstbytes];
  bfSSS_t* s_dash_dash_key = &state_bits_key[Nstbits + 5 * 8 * Nstbytes + Nstbits];

  bfSSS_t* b_key = BFSSS_ALLOC(Nstbytes);
  bfSSS_t* s_key = &state_bits_key[Nstbits + 5 * 8 * Nstbytes + 2 * Nstbits];

  // line 2
  for (unsigned int r = 0; r < FAEST_SSS_R / 2; r++) {
    // line 3
    bfSSS_t* state_key = BFSSS_ALLOC(Nstbytes);

    // line 4
    aes_SS_sbox_eval_verifier(state_key, state_bits_key, delta_i, Nst);

    // line 5
    bfSSS_t* state_key_tmp = BFSSS_ALLOC(Nstbytes);
    aes_SSS_shiftrows_verifier(state_key_tmp, state_key, Nst);

    // line 6
    aes_SSS_mix_columns_verifier(state_key, state_key_tmp, Nst);

    // line 7
    bfSSS_t* k_key = BFSSS_ALLOC(Nstbytes);
    aes_SSS_state_to_bytes_verifier(k_key, rkeys_key + (2 * r + 1) * Nstbits, Nst);
    aes_SSS_add_round_key_bytes_verifier(state_key_tmp, state_key, k_key, delta_i, Nst);

    // line 10
    if (r == FAEST_SSS_R / 2 - 1) {
      aes_SSS_add_round_key_verifier(s_tilde_key, owf_out_key, rkeys_key + FAEST_SSS_R * Nstbits,
                                     Nst);
    } else {
      // line 11
      memcpy(s_tilde_key, &w_key[(Nstbits * r)], Nstbits * sizeof(bfSSS_t));
    }

    // line 15
    aes_SSS_inverse_shiftrows_verifier(s_dash_dash_key, s_tilde_key, Nst);
    // line 16
    for (unsigned n = 0; n < Nstbytes; n++) {
      b_key[n] = bfSSS_zero();
    }
    aes_SSS_inverse_sbox_eval_verifier(b_key, s_dash_dash_key, delta_i, Nst);

    // line 17
    bfSSS_t tmp;
    for (unsigned int byte_i = 0; byte_i < Nstbytes; byte_i++) {
      bfSSS_add(&tmp, &b_key[byte_i], &state_key_tmp[byte_i]);
      zk_hash_SSS_update(hasher, &tmp);
    }

    faest_aligned_free(state_key_tmp);
    faest_aligned_free(state_key);
    faest_aligned_free(k_key);

    // line 21
    if (r != (FAEST_SSS_R / 2) - 1) {
      bfSSS_t* tmp_state_key = s_key;
      aes_SSS_bitwise_mix_column_verifier(tmp_state_key, s_tilde_key, Nst);
      aes_SSS_add_round_key_verifier(state_bits_key, tmp_state_key,
                                     rkeys_key + (2 * r + 2) * Nstbits, Nst);
    }
  }

  faest_aligned_free(b_key);
  faest_aligned_free(state_bits_key);
}

// OWF CONSTRAINTS
static void aes_SSS_constraints_prover(zk_hash_SSS_7_ctx* hasher, const uint8_t* w,
                                       const bfSSS_t* w_tag, const uint8_t* owf_in,
                                       const uint8_t* owf_out, const faest_paramset_t* params) {
  const unsigned int Lke       = params->Lke;
  const unsigned int Lenc      = params->Lenc;
  const unsigned int Nst       = params->Nst;
  const unsigned int blocksize = 32 * params->Nst;
  const unsigned int beta      = (FAEST_SSS_LAMBDA + blocksize - 1) / blocksize;
  // ::1-3 owf_in, owf_out, z and z_tag

  // line 5
  bfSSS_t v1;
  bfSSS_t tmp;
  bfSSS_mul_bit(&v1, &w_tag[0], ptr_get_bit(w, 1));
  bfSSS_mul_bit(&tmp, &w_tag[1], ptr_get_bit(w, 0));
  bfSSS_add_inplace(&v1, &tmp);
  bfSSS_mul(&tmp, &w_tag[0], &w_tag[1]);
  zk_hash_SSS_7_raise_and_update(hasher, &tmp, &v1);

  // line 7
  uint8_t* in        = malloc((beta + FAEST_SSS_R + 2) * blocksize / 8);
  uint8_t* out       = &in[blocksize / 8];
  uint8_t* rkeys     = &in[(beta + 1) * blocksize / 8];
  bfSSS_t* in_tag    = BFSSS_ALLOC(blocksize * (beta + FAEST_SSS_R + 2));
  bfSSS_t* out_tag   = &in_tag[blocksize];
  bfSSS_t* rkeys_tag = &in_tag[blocksize * (beta + 1)];
  assert(in);
  assert(in_tag);

  if (faest_is_em(params)) {
    aes_round_keys_t round_keys;
    expand_key(&round_keys, owf_in, FAEST_SSS_NK, FAEST_SSS_NK, FAEST_SSS_R);

    for (unsigned int r = 0, idx = 0; r < FAEST_SSS_R + 1; r++) {
      for (unsigned int n = 0; n < Nst; n++) {
        for (unsigned int i = 0; i < 4; ++i, ++idx) {
          rkeys[idx] = round_keys.round_keys[r][n][i];
        }
      }
    }
    memset(rkeys_tag, 0, sizeof(bfSSS_t) * (FAEST_SSS_R + 1) * Nst * 4 * 8);

    // line 10
    memcpy(in, w, blocksize / 8);
    memcpy(in_tag, w_tag, blocksize * sizeof(bfSSS_t));
    // line 11
    xor_u8_array(w, owf_out, out, blocksize / 8);
    memcpy(out_tag, w_tag, blocksize * sizeof(bfSSS_t));
  } else {
    // line 13
    memcpy(in, owf_in, blocksize / 8);
    constant_to_vole_SSS_prover(in_tag, blocksize);

    // line 14-15
    memcpy(out, owf_out, beta * blocksize / 8);
    constant_to_vole_SSS_prover(out_tag, beta * blocksize);

    // line 16
    aes_SSS_expkey_constraints_prover(hasher, rkeys, rkeys_tag, w, w_tag, params);
  }

  // line 18
  for (unsigned int b = 0; b < beta; b++) {
    // line 20
    if (b == 1) {
      in[0] = in[0] ^ 0x01;
    }
    // line 21
    aes_SSS_enc_constraints_prover(hasher, in, in_tag, out + b * blocksize / 8,
                                   out_tag + b * blocksize, w + (Lke + b * Lenc) / 8,
                                   w_tag + Lke + b * Lenc, rkeys, rkeys_tag, Nst);
  }

  faest_aligned_free(in_tag);
  free(in);
}

// OWF CONSTRAINTS VERIFIER
static void aes_SSS_constraints_verifier(zk_hash_SSS_ctx* hasher, const bfSSS_t* w_key,
                                         const uint8_t* owf_in, const uint8_t* owf_out,
                                         const bfSSS_t* delta_i, const faest_paramset_t* params) {
  const unsigned int Lke       = params->Lke;
  const unsigned int Lenc      = params->Lenc;
  const unsigned int Nst       = params->Nst;
  const unsigned int blocksize = 32 * Nst;
  const unsigned int beta      = (FAEST_SSS_LAMBDA + blocksize - 1) / blocksize;

  // line 5
  bfSSS_t v;
  bfSSS_mul(&v, &w_key[0], &w_key[1]);
  bfSSS_mul_inplace(&v, &delta_i[5]);
  zk_hash_SSS_update(hasher, &v);

  // line 7
  bfSSS_t* rkeys_key = BFSSS_ALLOC((FAEST_SSS_R + 2 + beta) * blocksize);
  bfSSS_t* in_key    = &rkeys_key[(FAEST_SSS_R + 1) * blocksize];
  bfSSS_t* out_key   = &rkeys_key[(FAEST_SSS_R + 2) * blocksize];
  assert(rkeys_key);

  if (faest_is_em(params)) {
    aes_round_keys_t round_keys;
    expand_key(&round_keys, owf_in, FAEST_SSS_NK, FAEST_SSS_NK, FAEST_SSS_R);

    unsigned int idx = 0;
    for (unsigned int r = 0; r < FAEST_SSS_R + 1; ++r) {
      for (unsigned int n = 0; n < Nst; ++n) {
        for (unsigned int i = 0; i < 4; ++i) {
          uint8_t rk_byte = round_keys.round_keys[r][n][i];
          for (unsigned int j = 0; j < 8; ++j, ++idx) {
            bfSSS_mul_bit(&rkeys_key[idx], &delta_i[1], get_bit(rk_byte, j));
          }
        }
      }
    }
    // ::10-11
    memcpy(in_key, w_key, blocksize * sizeof(bfSSS_t));
    for (unsigned int i = 0; i < blocksize; i++) {
      bfSSS_mul_bit(&out_key[i], &delta_i[1], ptr_get_bit(owf_out, i));
      bfSSS_add_inplace(&out_key[i], &w_key[i]);
    }
  } else {
    // line 13
    constant_to_vole_SSS_verifier(in_key, owf_in, &delta_i[1], blocksize);

    // line 14-15
    // if beta=2, load both public key blocks
    constant_to_vole_SSS_verifier(out_key, owf_out, &delta_i[1], beta * blocksize);

    // line 16
    aes_SSS_expkey_constraints_verifier(hasher, rkeys_key, w_key, delta_i, params);
  }
  // line 18
  for (unsigned int b = 0; b < beta; b++) {
    // line 20
    if (b == 1) {
      bfSSS_add_inplace(&in_key[0], &delta_i[1]); // adding one and multiplying with delta
    }
    aes_SSS_enc_constraints_verifier(hasher, in_key, out_key + b * blocksize,
                                     w_key + Lke + b * Lenc, rkeys_key, delta_i, Nst);
  }

  faest_aligned_free(rkeys_key);
}

// OWF PROVER
// clang-format off
void aes_@SSS@_prover(uint8_t* a0_tilde, uint8_t* a1toi_tilde, const uint8_t* w, uint8_t** V, 
                      const uint8_t* u_bar, const uint8_t* v_bar, const uint8_t* owf_in, 
                      const uint8_t* owf_out, const uint8_t* chall_2, const faest_paramset_t* params) {
  // clang-format on
  const unsigned int ell          = params->ell;
  const unsigned int lambda       = params->lambda;
  const unsigned int lambda_bytes = lambda / 8;

  // line 3
  // V becomes the w_tag: ell + 2*lambda field elements
  bfSSS_t* w_tag = shrink_V_SSS(V, ell); // This is the tag for w

  // line 7 deg-7
  zk_hash_SSS_7_ctx hasher7;
  zk_hash_SSS_7_init(&hasher7, chall_2);

  for (unsigned int ell_idx = 0; ell_idx < ell; ell_idx++) {

    uint8_t one_minus_w = 0;
    ptr_set_bit(&one_minus_w, 0, 1 ^ ptr_get_bit(w, ell_idx));

    bfSSS_t bf_deg_1[2];
    bfSSS_t bf_deg_0;
    bfSSS_mul(&bf_deg_0, &w_tag[ell_idx],
              &w_tag[ell_idx]); // deg-0 * deg-0    // one_minus_w has same w_tag

    bfSSS_mul_bit(&bf_deg_1[0], &w_tag[ell_idx], one_minus_w);             // deg-0 * deg-1
    bfSSS_mul_bit(&bf_deg_1[1], &w_tag[ell_idx], ptr_get_bit(w, ell_idx)); // deg-1 * deg-0
    bfSSS_add_inplace(&bf_deg_1[0], &bf_deg_1[1]);                         // adding deg-1s

    zk_hash_SSS_7_raise_and_update(&hasher7, &bf_deg_0, bf_deg_1);
  }

  // line 9 deg-7
  aes_SSS_constraints_prover(&hasher7, w, w_tag, owf_in, owf_out, params);

  // line 13 deg-7
  bfSSS_t x1_sum[7];
  bfSSS_sum_poly_bits(&x1_sum[0], (const uint8_t*)v_bar);
  for (unsigned int j = 1; j <= D_ZK - 2; j++) {
    bfSSS_t tmp1;
    bfSSS_t tmp2;
    bfSSS_sum_poly_bits(&tmp1, (const uint8_t*)u_bar + (j - 1) * lambda_bytes);
    bfSSS_sum_poly_bits(&tmp2, (const uint8_t*)v_bar + j * lambda_bytes);

    bfSSS_add(&x1_sum[j], &tmp1, &tmp2);
  }
  bfSSS_sum_poly_bits(&x1_sum[D_ZK - 1], (const uint8_t*)u_bar + (D_ZK - 2) * lambda_bytes);

  // deg-7
  zk_hash_SSS_7_finalize(a0_tilde, a1toi_tilde, &hasher7, x1_sum);

  faest_aligned_free(w_tag);
}

// OWF VERIFIER
// clang-format off
void aes_@SSS@_verifier(uint8_t* a0_tilde, const uint8_t* d, uint8_t** Q,
                          const uint8_t* q_bar, const uint8_t* owf_in, const uint8_t* owf_out,
                          const uint8_t* chall_2, const uint8_t* Delta, const uint8_t* a1toi_tilde, const faest_paramset_t* params) {
  // clang-format on
  const unsigned int ell          = params->ell;
  const unsigned int lambda       = params->lambda;
  const unsigned int lambda_bytes = (lambda + 7) / 8;

  // line 3
  bfSSS_t* Q_key = shrink_V_SSS(Q, ell);

  // line 12
  zk_hash_SSS_ctx b_ctx;
  zk_hash_SSS_init(&b_ctx, chall_2);

  // line 3,5 initializing
  bfSSS_t bf_delta[D_ZK + 1];
  bf_delta[0] = bfSSS_one();
  bfSSS_load(&bf_delta[1], Delta);
  for (unsigned int j = 2; j < D_ZK + 1; j++) {
    bfSSS_mul(&bf_delta[j], &bf_delta[j - 1], &bf_delta[1]);
  }

  // line 3
  for (unsigned int i = 0; i < ell; i++) {
    bfSSS_t tmp;
    bfSSS_mul_bit(&tmp, &bf_delta[1], ptr_get_bit(d, i));
    bfSSS_add_inplace(&Q_key[i], &tmp);
  }

  // line 5
  bfSSS_t q_star;
  bfSSS_sum_poly_bits(&q_star, q_bar);
  for (unsigned int j = 1; j < D_ZK - 1; j++) {
    bfSSS_t tmp;
    bfSSS_sum_poly_bits(&tmp, q_bar + j * lambda_bytes);
    bfSSS_mul_inplace(&tmp, &bf_delta[j]);
    bfSSS_add_inplace(&q_star, &tmp);
  }

  // line 7
  for (unsigned int i = 0; i < ell; i++) {
    bfSSS_t t, u;
    bfSSS_add(&u, &Q_key[i], &bf_delta[1]); // 1 (delta) - w
    bfSSS_mul(&t, &Q_key[i], &u);           // w * (1 (delta) - w)
    bfSSS_mul_inplace(&t, &bf_delta[5]);
    zk_hash_SSS_update(&b_ctx, &t);
  }

  // line 9
  aes_SSS_constraints_verifier(&b_ctx, Q_key, owf_in, owf_out, bf_delta, params);

  faest_aligned_free(Q_key);

  // line 12
  uint8_t q_tilde[FAEST_SSS_LAMBDA / 8];
  zk_hash_SSS_finalize(q_tilde, &b_ctx, &q_star);

  // line 14
  bfSSS_t acc;
  bfSSS_load(&acc, a1toi_tilde);
  bfSSS_mul_inplace(&acc, &bf_delta[1]);
  for (unsigned int j = 2; j < D_ZK; j++) {
    bfSSS_t tmp;
    bfSSS_load(&tmp, a1toi_tilde + (j - 1) * lambda_bytes);
    bfSSS_mul_inplace(&tmp, &bf_delta[j]);
    bfSSS_add_inplace(&acc, &tmp);
  }

  bfSSS_t tmp;
  bfSSS_load(&tmp, q_tilde);
  bfSSS_add_inplace(&acc, &tmp);
  bfSSS_store(a0_tilde, &acc);
}
