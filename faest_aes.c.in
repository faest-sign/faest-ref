static_assert(FAEST_@SSS@F_Lke == FAEST_@SSS@S_Lke, "Invalid parameters");
static_assert(FAEST_@SSS@F_Nst == FAEST_@SSS@S_Nst, "Invalid parameters");
static_assert(FAEST_SSS_R == FAEST_@SSS@S_R, "Invalid parameters");
static_assert(FAEST_@SSS@F_R == FAEST_@SSS@S_R, "Invalid parameters");
